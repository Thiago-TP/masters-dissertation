\begin{tikzpicture}[> = Latex]
    % Blocks
    \node [startstop] (start)
        {Start};

    \node [io, right=0.5 of start, text width=2.25cm] (data)
        {Get field observations};

    \node [process, right=.5 of data, text width=2.5cm] (adjustment)
        {Adjust model parameters};

    \node [process, right=.5 of adjustment, text width=2cm] (simulation)
        {Run simulation};
        
    \node [decision, text width=1.5cm, right=0.5 of simulation] (decision)
        {Good match?};
    
    \node [startstop, right=1 of decision] (stop)
        {Stop};

    % Arrows
    \draw [->] (start) -- (data);
    \draw [->] (data) -- (adjustment);
    \draw [->] (adjustment) -- (simulation);
    \draw [->] (simulation) -- (decision);
    \draw [->] (decision.north) --++ (0, .5) -| (adjustment);
    \node [above=1.35 of simulation] {No};
    \draw [->] (decision) -- (stop) node [midway, above, xshift=-1mm] {Yes};
\end{tikzpicture}