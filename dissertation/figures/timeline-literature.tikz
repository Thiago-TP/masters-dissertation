\begin{tikzpicture}[xscale=1/2.65]
    \def\startyear{1990}
    % Time axis
    \draw[-Latex, line width=1] (1990-\startyear, 0) -- (2030-\startyear, 0);
    %% major ticks
    \foreach \year in {1990, 2000, 2010, 2020, 2030}{
        \draw (\year-\startyear, 0) --++ (0, -1) node [left, rotate=90] {\year};
    }
    %% minor ticks
    \foreach \year in {1995, 2005, 2015, 2025}{
        \draw (\year-\startyear, 0) --++ (0, -.5) node [left, rotate=90] {\year};
    }
    %% very minor tickes
    \foreach \year in {
        1991, 1992, 1993, 1994, 1996, 1997, 1998, 1999,
        2001, 2002, 2003, 2004, 2006, 2007, 2008, 2009,
        2011, 2012, 2013, 2014, 2016, 2017, 2018, 2019,
        2021, 2022, 2023, 2024, 2026, 2027, 2028, 2029
    }{
        \draw (\year-\startyear, 0) --++ (0, -.25);
    }
    
    % Place all nodes
