\begin{tikzpicture}[scale=2]

    % Iteration 0 (prior)
    \draw [-Latex] (0, 0) -- (2, 0) node [midway, below] {Datum 1};
    \draw [-Latex] (0, 0) -- (0, 2) node [midway, above, rotate=90] {Datum 2};
    % Optimal distribution 
    %% posterior covariance
    \draw [azulunb] (1.5, 1.5) circle (0.5 and 0.25);
    %% posterior mean
    \fill [azulunb] (1.5, 1.5) circle (0.05);
    % Prior distribution
    \draw [gray] (1, 1) circle (0.75);
    \fill [gray] (1, 1) circle (0.05);
    % Observation
    \fill (1.25, 1.5) circle (0.05);
    \draw (1.25, 1.5) --++ (160:0.75) node [left] {$\mathbf{d}_\text{obs}$};
    % Annotation: iteration step
    \node at (1, 2) [above] {$l=0$};

    % Iteration 1 (SDA and first posterior of MDA)
    \begin{scope}[shift={(2.25, 0)}]
        % Optimal distribution 
        %% posterior covariance
        \draw [azulunb!50, dashed] (1.5, 1.5) circle (0.5 and 0.25);
        %% posterior mean
        \fill [azulunb!50] (1.5, 1.5) circle (0.05);
        % Prior distribution
        \draw [gray!50, dashed] (1, 1) circle (0.75);
        \fill [gray!50] (1, 1) circle (0.05);
        % Observation
        \fill (1.25, 1.5) circle (0.05);

        %% SDA posterior covariance
        \draw [thick, verdeunb] (1.3, 1.3) ellipse (0.55 and 0.2);
        %% SDA posterior mean
        \fill [verdeunb] (1.3, 1.3) circle (0.05);

        %% MDA 1st posterior covariance
        \draw [thick, highlight] (1.35, 1.1) circle (0.6 and 0.4);
        %% MDA 1st posterior mean
        \fill [highlight!90] (1.35, 1.1) circle (0.05);

        %% Annotation: iteration step
        \node at (1, 2) [above] {$l=1$};

        \draw [-Latex] (0, 0) -- (2, 0) node [midway, below] {Datum 1};
        \draw [-Latex] (0, 0) -- (0, 2);
    \end{scope}

    % Iteration 2 (SDA and two posteriors of MDA) 
    \begin{scope}[shift={(4.5, 0)}]
        % Optimal distribution 
        %% posterior covariance
        \draw [azulunb!50, dashed] (1.5, 1.5) circle (0.5 and 0.25);
        %% posterior mean
        \fill [azulunb!50] (1.5, 1.5) circle (0.05);
        % Prior distribution
        \draw [gray!50, dashed] (1, 1) circle (0.75);
        \fill [gray!50] (1, 1) circle (0.05);
        % Observation
        \fill (1.25, 1.5) circle (0.05);

        %% SDA posterior covariance
        \draw [thick, verdeunb] (1.3, 1.3) ellipse (0.55 and 0.2);
        %% SDA posterior mean
        \fill [verdeunb] (1.3, 1.3) circle (0.05);

        %% MDA 1st posterior covariance
        \draw [highlight!50, dashed] (1.35, 1.1) circle (0.6 and 0.4);
        %% MDA 1st posterior mean
        \fill [highlight!50, dashed] (1.35, 1.1) circle (0.05);

        %% MDA 2nd posterior covariance
        \draw [thick, highlight] (1.4, 1.4) circle (0.5 and 0.25);
        %% MDA 2nd posterior mean
        \fill [highlight] (1.4, 1.4) circle (0.05);

        %% Annotation: iteration step
        \node at (1, 2) [above] {$l=2$};

        \draw [-Latex] (0, 0) -- (2, 0) node [midway, below] {Datum 1};
        \draw [-Latex] (0, 0) -- (0, 2);
    \end{scope}
\end{tikzpicture}