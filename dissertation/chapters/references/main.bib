@article{Oniram:2025,
    author = {Limaverde Filho, Jos\'e Oniram de A. and Paula, Thiago T. de and Pastrana, M\'ario A. and Mu\~noz, Daniel M. and Santos, Marcelo G. and Fortaleza, Eug\^enio L. F.},
    title = {Robust Adaptive Model Aggregation for Well Production Forecasting},
    journal = {SPE Journal},
    volume = {30},
    number = {07},
    pages = {3984-4006},
    year = {2025},
    month = {07},
    abstract = {Recent advances in closed-loop reservoir management enable the optimization of the production of the entire reservoir life cycle using short- and medium-term production forecasts. Within this context, strategies based on sequential model aggregation have gained prominence for generating production forecasts in reservoirs at a fraction of the computational cost of those used by industry nowadays. However, mitigating the influence of field data measurement noise on forecasts can be very challenging from a practical standpoint. With this work, we propose a robust adaptive model aggregation (AMA) method that incorporates an adaptive exponential moving average-based filter to mitigate the effects of measurement noise on forecast accuracy. The effectiveness of the proposed approach is demonstrated through simulations on synthetic reservoirs (Egg and OLYMPUS) and on a carbonate reservoir in a Brazilian pre-salt field and is compared with the results of three established model aggregation methods from the related literature—ridge, lasso, and exponentially weighted average (EWA). Findings indicate that the proposed approach is consistently the most accurate predictor of production rates, particularly oil production rates (OPRs), in the presence of measurement noise compared with other forecasting methods considered.},
    issn = {1086-055X},
    doi = {10.2118/226207-PA},
    url = {https://doi.org/10.2118/226207-PA},
    eprint = {https://onepetro.org/SJ/article-pdf/30/07/3984/4844253/spe-226207-pa.pdf},
}

