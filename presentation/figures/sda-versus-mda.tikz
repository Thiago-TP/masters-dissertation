\begin{tikzpicture}[scale=1.75, domain=-1:1, samples=200]

    % Iteration 0 (prior)
    \draw [-Latex] (0, 0) -- (2, 0) node [midway, below] {Datum 1};
    \draw [-Latex] (0, 0) -- (0, 2) node [midway, above, rotate=90] {Datum 2};
    % Optimal distribution 
    %% posterior covariance
    \draw [thick, azulunb] (1.5, 1.5) circle (0.5 and 0.25);
    %% posterior mean
    \fill [thick, azulunb] (1.5, 1.5) circle (0.04);
    % Prior distribution
    \draw [thick, darkred] (1, 1) circle (0.75);
    \fill [darkred] (1, 1) circle (0.04);
    % Observation
    \fill (1.25, 1.5) circle (0.04);
    \draw (1.25, 1.5) --++ (160:0.75) node [left] {$\mathbf{d}_\text{obs}$};
    % Annotation: iteration step
    \node at (1, 2) [above] {$\ell=0$};

    \begin{scope}[shift={(1, -2)}]
        \draw (-1, 0) -- (1, 0);
        \draw [thick, highlight, variable=\x]
            plot ({\x}, {1.50863 * exp(-6 * (\x-0.58333) * (\x-0.58333))});
        \draw [thick, darkred, variable=\x] 
            plot ({\x}, {0.75 * exp(-(\x * \x)/0.25)});
        \fill [darkred] (0, 0.75) circle (0.04);
        \node [highlight] at (1.1, 1) {$\mathcal{L}^1$};
    \end{scope}

    % Iteration 1 (SDA and first posterior of MDA)
    \begin{scope}[shift={(2.25, 0)}]
        % Optimal distribution 
        %% posterior covariance
        \draw [thick, azulunb] (1.5, 1.5) circle (0.5 and 0.25);
        %% posterior mean
        \fill [azulunb] (1.5, 1.5) circle (0.04);
        % Observation
        \fill (1.25, 1.5) circle (0.04);

        %% MDA 1st posterior covariance
        \draw [thick, darkred] (1.35, 1.1) circle (0.6 and 0.4);
        %% MDA 1st posterior mean
        \fill [darkred] (1.35, 1.1) circle (0.04);

        %% Annotation: iteration step
        \node at (1, 2) [above] {$\ell=1$};

        \draw [-Latex] (0, 0) -- (2, 0) node [midway, below] {Datum 1};
        \draw [-Latex] (0, 0) -- (0, 2);

        \begin{scope}[shift={(1, -2)}]
            \draw (-1, 0) -- (1, 0);
            \draw [thick, highlight, variable=\x]
                plot ({\x}, {1.03174 * exp(-40 * (\x-0.4125) * (\x-0.4125))});
            \draw [thick, darkred, variable=\x, domain=-1:1, smooth]
                plot ({\x}, {0.5 * exp(-((\x-0.35) * (\x-0.35))/0.1)});
            \fill [darkred] (0.35, 0.5) circle (0.04);
            \node [highlight] at (0.75, 1) {$\mathcal{L}^2$};
        \end{scope}
    \end{scope}

    % Iteration 2 (SDA and two posteriors of MDA) 
    \begin{scope}[shift={(4.5, 0)}]
        % Optimal distribution 
        %% posterior covariance
        \draw [thick, azulunb] (1.5, 1.5) circle (0.5 and 0.25);
        %% posterior mean
        \fill [azulunb] (1.5, 1.5) circle (0.04);
        % Observation
        \fill (1.25, 1.5) circle (0.04);

        %% MDA 2nd posterior covariance
        \draw [thick, darkred] (1.4, 1.4) circle (0.5 and 0.25);
        %% MDA 2nd posterior mean
        \fill [darkred] (1.4, 1.4) circle (0.04);

        %% Annotation: iteration step
        \node at (1, 2) [above] {$\ell=2$};

        \draw [-Latex] (0, 0) -- (2, 0) node [midway, below] {Datum 1};
        \draw [-Latex] (0, 0) -- (0, 2);

        \begin{scope}[shift={(1, -2)}]
            \draw (-1, 0) -- (1, 0);
            \draw [thick, darkred, variable=\x, domain=-1:1, smooth]
                plot ({\x}, {0.5 * exp(-((\x-0.4) * (\x-0.4))/0.02)});
            \fill [darkred] (0.4, 0.5) circle (0.04);
        \end{scope}
    \end{scope}
\end{tikzpicture}